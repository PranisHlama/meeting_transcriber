<odoo>
  <data>
    <record id="meeting_transcription_view_list" model="ir.ui.view">
      <field name="name">meeting.transcription.list</field>
      <field name="model">meeting.transcription</field>
      <field name="arch" type="xml">
        <list string="Meeting Transcriptions">
          <field name="name"/>
          <field name="calendar_event_id"/>
          <field name="recording_filename"/>
          <field name="state"/>
        </list>
      </field>
    </record>

    <record id="meeting_transcription_view_form" model="ir.ui.view">
      <field name="name">meeting.transcription.form</field>
      <field name="model">meeting.transcription</field>
      <field name="arch" type="xml">
        <form string="Meeting Transcription">
          <header>
            <button name="action_process_recording"
                    string="Process Recording"
                    type="object"
                    class="btn-primary"
                    invisible="state not in ['draft', 'uploaded', 'failed']"
                    />
            <field name="state" widget="statusbar"/>
          </header>
          <sheet>
            <group>
              <field name="name"/>
              <field name="calendar_event_id"/>
              <field name="recording_filename"/>
              <field name="recording_file" widget="binary" filename="recording_filename"/>
              <field name="extracted_audio_filename" readonly="1"/>
              <field name="extracted_audio_file" widget="binary" filename="extracted_audio_filename" readonly="1"/>
              <field name="media_metadata" readonly="1"/>
              <field name="error_message" readonly="1"/>
            </group>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>

    <record id="meeting_transcription_action" model="ir.actions.act_window">
      <field name="name">Meeting Transcriptions</field>
      <field name="res_model">meeting.transcription</field>
      <field name="view_mode">list,form</field>
    </record>

    <menuitem id="meeting_transcriber_menu_root"
              name="Meeting Transcriber"
              sequence="10"/>

    <menuitem id="meeting_transcriber_menu"
              name="Transcriptions"
              parent="meeting_transcriber_menu_root"
              action="meeting_transcription_action"
              sequence="10"/>
  </data>
</odoo>
